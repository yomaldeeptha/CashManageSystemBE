NODE_ENV=production
PORT=4000

# Neon PostgreSQL pooled connection string (include pgbouncer=true for Vercel serverless)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require&pgbouncer=true&connection_limit=15&pool_timeout=30&connect_timeout=15"

# Neon PostgreSQL direct (unpooled) connection string (used by Prisma migrations)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# Comma-separated list of approved frontend origins for CORS (supports wildcards like https://your-app-*.vercel.app)
FRONTEND_URL="https://your-frontend.vercel.app,http://localhost:3010"

# JWT Secrets - replace with long cryptographically random strings (min 32 chars)
ACCESS_TOKEN_SECRET="replace-with-a-long-random-access-token-secret-at-least-32-chars"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="replace-with-a-different-long-random-refresh-token-secret-32-chars"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Optional: set ENABLE_SWAGGER=true to expose /api/docs in production
ENABLE_SWAGGER=false

# Upload directory & limits (on Vercel, defaults automatically to /tmp/bnf-cms-uploads when unset)
MAX_UPLOAD_SIZE_BYTES=10485760

# Optional rate limiting defaults
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
