NODE_ENV=development
PORT=4000

# Neon PostgreSQL pooled connection string (used at application runtime; pulled by `neon deploy`)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require"

# Neon PostgreSQL direct (unpooled) connection string (used by Prisma migrations; pulled by `neon deploy`)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require"

# Comma-separated list of approved frontend origins for CORS
FRONTEND_URL="http://localhost:3010,http://localhost:3000"

# JWT Secrets - replace with long cryptographically random strings (min 32 chars)
ACCESS_TOKEN_SECRET="replace-with-a-long-random-access-token-secret-at-least-32-chars"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="replace-with-a-different-long-random-refresh-token-secret-32-chars"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Upload directory & limits (in bytes; default 10MB)
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_BYTES=10485760

# Optional rate limiting defaults
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
