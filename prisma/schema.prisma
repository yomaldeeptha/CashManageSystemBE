  departmentName    String   @db.VarChar(150)
  requesterName     String   @db.VarChar(150)
  employeeNo        String   @db.VarChar(50)
  receivedByName    String   @db.VarChar(150)
  advanceAmount     Decimal  @default(0) @db.Decimal(18, 2)
  settledAmount     Decimal  @default(0) @db.Decimal(18, 2)
  balance           Decimal  @default(0) @db.Decimal(18, 2)
  receiptType       String   @default("Cash") @db.VarChar(40)
  bankOrCashAccount String   @db.VarChar(200)
  returnAmount      Decimal  @db.Decimal(18, 2)
  currencyId        Int
  exRate            Decimal  @default(1) @db.Decimal(18, 6)
  baseCurrencyCode  String   @default("USD") @db.VarChar(10)
  baseReturnAmount  Decimal  @default(0) @db.Decimal(18, 2)
  amountInWords     String?  @db.VarChar(255)
  narration         String?  @db.Text
  status            String   @default("Receipt Issued & Settled") @db.VarChar(60)
  createdById       Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createUserId      Int?
  updateUserId      Int?

  company        Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch         Branch                   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  outlet         Outlet?                  @relation(fields: [outletId], references: [id], onDelete: SetNull)
  request        PettyCashRequest?        @relation(fields: [requestId], references: [id], onDelete: SetNull)
  advance        PettyCashAdvance?        @relation(fields: [advanceId], references: [id], onDelete: SetNull)
  billSubmission PettyCashBillSubmission? @relation(fields: [billSubmissionId], references: [id], onDelete: SetNull)
  department     Department?              @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  currency       Currency                 @relation(fields: [currencyId], references: [id], onDelete: Restrict)

  @@index([companyId, branchId])
  @@index([advanceId])
  @@index([createUserId])
  @@index([updateUserId])
  @@map("petty_cash_returns")
}

model FloatReimbursement {
  id                Int      @id @default(autoincrement())
  docNo             String   @unique @db.VarChar(60)
  docDate           DateTime @db.Date
  fromDate          DateTime @db.Date
  toDate            DateTime @db.Date
  companyId         Int
  branchId          Int
  outletId          Int?
  locationName      String?  @db.VarChar(150)
  floatAccountId    Int?
  floatAccountName  String   @db.VarChar(200)
  baseCurrencyCode  String   @default("USD") @db.VarChar(10)
  floatAmount       Decimal  @default(0) @db.Decimal(18, 2)
  reimburseAmount   Decimal  @default(0) @db.Decimal(18, 2)
  settledAmount     Decimal  @default(0) @db.Decimal(18, 2)
  balanceCashInHand Decimal  @default(0) @db.Decimal(18, 2)
  narration         String?  @db.Text
  status            String   @default("Draft") @db.VarChar(60)
  createdById       Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createUserId      Int?
  updateUserId      Int?

  company      Company                     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch       Branch                      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  outlet       Outlet?                     @relation(fields: [outletId], references: [id], onDelete: SetNull)
  floatAccount FloatAccount?               @relation(fields: [floatAccountId], references: [id], onDelete: SetNull)
  vouchers     FloatReimbursementVoucher[]

  @@index([companyId, branchId])
  @@index([status])
  @@index([createUserId])
  @@index([updateUserId])
  @@map("float_reimbursements")
}

model FloatReimbursementVoucher {
  id                  Int     @id @default(autoincrement())
  reimbursementId     Int
  billSubmissionId    Int?
  requestRef          String? @db.VarChar(60)
  voucherNo           String  @db.VarChar(60)
  voucherDate         String  @db.VarChar(40)
  employeeName        String  @db.VarChar(150)
  expenseCategoryName String  @db.VarChar(150)
  remark              String? @db.VarChar(255)
  amount              Decimal @db.Decimal(18, 2)
  runningTotal        Decimal @db.Decimal(18, 2)

  reimbursement  FloatReimbursement       @relation(fields: [reimbursementId], references: [id], onDelete: Cascade)
  billSubmission PettyCashBillSubmission? @relation(fields: [billSubmissionId], references: [id], onDelete: SetNull)
  createUserId   Int?
  updateUserId   Int?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @default(now()) @updatedAt

  @@index([reimbursementId])
  @@index([createUserId])
  @@index([updateUserId])
  @@map("float_reimbursement_vouchers")
}

model PettyCashIOU {
  id                Int      @id @default(autoincrement())
  docId             String   @unique @db.VarChar(60)
  docDate           DateTime @db.Date
  advanceId         Int?     @unique
  employeeId        Int?
  employeeName      String   @db.VarChar(150)
  employeeNo        String   @db.VarChar(50)
  departmentName    String?  @db.VarChar(150)
  purpose           String?  @db.VarChar(255)
  baseCurrencyCode  String   @default("USD") @db.VarChar(10)
  advAmount         Decimal  @default(0) @db.Decimal(18, 2)
  settledAmount     Decimal  @default(0) @db.Decimal(18, 2)
  settledVfApproved String   @default("Pending Verification") @db.VarChar(60)
  returnAmount      Decimal  @default(0) @db.Decimal(18, 2)
  pendingAmount     Decimal  @default(0) @db.Decimal(18, 2)
  status            String   @default("Active Advance") @db.VarChar(60)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createUserId      Int?
  updateUserId      Int?

  advance  PettyCashAdvance? @relation(fields: [advanceId], references: [id], onDelete: SetNull)
  employee Employee?         @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([status])
  @@index([createUserId])
  @@index([updateUserId])
  @@map("petty_cash_ious")
}

// ============================================================================
// 5. PROCESS 03: SALES DAY-END RECONCILIATION & PERIOD LOCK
// ============================================================================

model SalesReconciliation {
  id                  Int       @id @default(autoincrement())
  docNo               String    @unique @db.VarChar(60)
  docDate             DateTime  @db.Date
  companyId           Int
  branchId            Int
  outletId            Int
  shiftId             Int?
  cashierId           Int?
  shiftStatus         String    @default("Closed") @db.VarChar(40)
  baseCurrencyCode    String    @default("USD") @db.VarChar(10)
  posGrossSales       Decimal   @default(0) @db.Decimal(18, 2)
  returnsAmount       Decimal   @default(0) @db.Decimal(18, 2)
  netSales            Decimal   @default(0) @db.Decimal(18, 2)
  totalCollectionBase Decimal   @default(0) @db.Decimal(18, 2)
  varianceAmount      Decimal   @default(0) @db.Decimal(18, 2)
  varianceStatus      String    @default("Matched (Zero Variance)") @db.VarChar(100)
  rootCauseCategory   String?   @db.VarChar(120)
  overrideReason      String?   @db.Text
  isPeriodLocked      Boolean   @default(false)
  lockedById          Int?
  lockedAt            DateTime?
  unblockedById       Int?
  unblockedAt         DateTime?
  unblockReason       String?   @db.Text
  status              String    @default("Draft") @db.VarChar(40)
  remark              String?   @db.Text
  approverName        String?   @db.VarChar(150)
  approverRemarks     String?   @db.Text
  approvedById        Int?
  approvedAt          DateTime?
  linkedCashDepositId Int?
  createdById         Int?
  updatedById         Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  createUserId        Int?
  updateUserId        Int?

  company           Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch            Branch                    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  outlet            Outlet                    @relation(fields: [outletId], references: [id], onDelete: Restrict)
  shift             Shift?                    @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  cashier           Employee?                 @relation(fields: [cashierId], references: [id], onDelete: SetNull)
  linkedCashDeposit CashDeposit?              @relation(fields: [linkedCashDepositId], references: [id], onDelete: SetNull)
  lines             SalesReconciliationLine[]
  varianceIncidents VarianceIncident[]

  @@index([companyId, branchId, outletId])
  @@index([docDate])
  @@index([status])
  @@index([createUserId])
  @@index([updateUserId])
  @@map("sales_reconciliations")
}

model SalesReconciliationLine {
  id                      Int     @id @default(autoincrement())
  reconciliationId        Int
  shiftId                 Int?
  shiftName               String  @db.VarChar(80)
  cashierName             String  @db.VarChar(150)
  shiftTotalSales         Decimal @default(0) @db.Decimal(18, 2)
  bankOrSafe              String  @db.VarChar(120)
  paymentTypeId           Int?
  paymentTypeName         String  @db.VarChar(100)
  subTypeName             String  @db.VarChar(120)
  currencyId              Int
  amount                  Decimal @default(0) @db.Decimal(18, 2)
  exRate                  Decimal @default(1) @db.Decimal(18, 6)
  baseAmount              Decimal @default(0) @db.Decimal(18, 2)
  autoFilledFromDepositId Int?
  diffType                String? @db.VarChar(60)
  remarks                 String? @db.VarChar(255)

  reconciliation        SalesReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  shift                 Shift?              @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  paymentType           PaymentType?        @relation(fields: [paymentTypeId], references: [id], onDelete: SetNull)
  currency              Currency            @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  autoFilledFromDeposit CashDeposit?        @relation(fields: [autoFilledFromDepositId], references: [id], onDelete: SetNull)
  createUserId          Int?
  updateUserId          Int?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @default(now()) @updatedAt

  @@index([reconciliationId])
  @@index([createUserId])
  @@index([updateUserId])
  @@map("sales_reconciliation_lines")
}

model VarianceIncident {
  id                 Int      @id @default(autoincrement())
  incidentCode       String   @unique @db.VarChar(60)
  reconciliationId   Int?
  incidentDate       DateTime @db.Date
  shiftTime          String   @db.VarChar(80)
  companyId          Int
  branchId           Int
  outletId           Int
  cashierId          Int?
  cashierName        String   @db.VarChar(150)
  type               String   @db.VarChar(20)
  posExpectedAmount  Decimal  @db.Decimal(18, 2)
  actualCountAmount  Decimal  @db.Decimal(18, 2)
  varianceAmount     Decimal  @db.Decimal(18, 2)
  rootCause          String   @db.VarChar(200)
  cashierExplanation String?  @db.Text
  checkerAction      String?  @db.Text
  recoveryMode       String?  @db.VarChar(80)
  auditStatus        String   @default("Investigating") @db.VarChar(50)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  createUserId       Int?
  updateUserId       Int?

  reconciliation SalesReconciliation? @relation(fields: [reconciliationId], references: [id], onDelete: SetNull)
  company        Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch         Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  outlet         Outlet               @relation(fields: [outletId], references: [id], onDelete: Restrict)
  cashier        Employee?            @relation(fields: [cashierId], references: [id], onDelete: SetNull)

  @@index([companyId, outletId])
  @@index([incidentDate])
  @@index([type])
  @@index([createUserId])
  @@index([updateUserId])
  @@map("variance_incidents")
}

// ============================================================================
// 6. PROCESS 04: MULTI-STAGE APPROVAL WORKFLOW ENGINE
// ============================================================================

model ApprovalStage {
  id           Int      @id @default(autoincrement())
  code         String   @unique @db.VarChar(50)
  name         String   @db.VarChar(150)
  noOfApproval Int      @default(1)
  noOfReject   Int      @default(1)
  description  String?  @db.Text
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createUserId Int?
  updateUserId Int?

  approvers      ApprovalStageApprover[]
  templateStages ApprovalTemplateStage[]
  decisions      ApprovalDecision[]

  @@index([createUserId])
  @@index([updateUserId])
  @@map("approval_stages")
}

model ApprovalStageApprover {
  id           Int     @id @default(autoincrement())
  stageId      Int
  userId       Int
  maxLimitBase Decimal @default(10000) @db.Decimal(18, 2)

  stage        ApprovalStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createUserId Int?
  updateUserId Int?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt

  @@unique([stageId, userId])
  @@index([stageId])
  @@index([createUserId])
  @@index([updateUserId])
  @@map("approval_stage_approvers")
}

model ApprovalTemplate {
  id                Int      @id @default(autoincrement())
  code              String   @unique @db.VarChar(50)
  name              String   @db.VarChar(150)
  description       String?  @db.Text
  governedDocuments String[] @default([])
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createUserId      Int?
  updateUserId      Int?

  stages      ApprovalTemplateStage[]
  originators ApprovalTemplateOriginator[]
  terms       ApprovalTemplateTerm[]
  instances   ApprovalInstance[]

  @@index([createUserId])
  @@index([updateUserId])
  @@map("approval_templates")
}

model ApprovalTemplateStage {
  id         Int @id @default(autoincrement())
  templateId Int
  stageId    Int
  stageOrder Int

  template     ApprovalTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  stage        ApprovalStage    @relation(fields: [stageId], references: [id], onDelete: Restrict)
  createUserId Int?
  updateUserId Int?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @default(now()) @updatedAt

  @@unique([templateId, stageOrder])
  @@index([templateId])
  @@index([createUserId])
  @@index([updateUserId])
  @@map("approval_template_stages")
}

model ApprovalTemplateOriginator {
  id         Int @id @default(autoincrement())
  templateId Int
  userId     Int

  template     ApprovalTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createUserId Int?
  updateUserId Int?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @default(now()) @updatedAt

  @@unique([templateId, userId])
  @@index([createUserId])
  @@index([updateUserId])
  @@map("approval_template_originators")
}

model ApprovalTemplateTerm {
  id          Int     @id @default(autoincrement())
  templateId  Int
  field       String  @db.VarChar(100)
  operator    String  @db.VarChar(20)
  value       String  @db.VarChar(120)
  description String? @db.VarChar(255)

  template     ApprovalTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  createUserId Int?
  updateUserId Int?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @default(now()) @updatedAt

  @@index([templateId])
  @@index([createUserId])
  @@index([updateUserId])
  @@map("approval_template_terms")
}

model ApprovalInstance {
  id                Int       @id @default(autoincrement())
  templateId        Int?
  entityType        String    @db.VarChar(60)
  entityId          Int
  docNo             String    @db.VarChar(80)
  title             String    @db.VarChar(255)
  companyId         Int
  branchId          Int?
  outletId          Int?
  submittedById     Int
  amountBase        Decimal   @default(0) @db.Decimal(18, 2)
  baseCurrencyCode  String    @default("USD") @db.VarChar(10)
  triggerSummary    String?   @db.VarChar(255)
  currentStageOrder Int       @default(1)
  totalStages       Int       @default(1)
  status            String    @default("Pending") @db.VarChar(40)
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createUserId      Int?
  updateUserId      Int?

  template    ApprovalTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  submittedBy User               @relation("ApprovalSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  decisions   ApprovalDecision[]

  @@index([entityType, entityId])
  @@index([status])
  @@index([companyId, outletId])
  @@index([createUserId])
  @@index([updateUserId])
  @@map("approval_instances")
}

model ApprovalDecision {
  id          Int      @id @default(autoincrement())
  instanceId  Int
  stageId     Int?
  stageOrder  Int
  decidedById Int
  decision    String   @db.VarChar(30)
  comment     String?  @db.Text
  decidedAt   DateTime @default(now())

  instance     ApprovalInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  stage        ApprovalStage?   @relation(fields: [stageId], references: [id], onDelete: SetNull)
  decidedBy    User             @relation(fields: [decidedById], references: [id], onDelete: Restrict)
  createUserId Int?
  updateUserId Int?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @default(now()) @updatedAt

  @@index([instanceId])
  @@index([createUserId])
  @@index([updateUserId])
  @@map("approval_decisions")
}

// ============================================================================
// 7. CENTRALIZED APPEND-ONLY CHANGE LOGS (FIELD-LEVEL AUDIT HISTORY)
// ============================================================================

enum ChangeLogAction {
  CREATE
  UPDATE
  DELETE
  CANCEL
  APPROVE
  REJECT
  POST
  REVERSE
  CLOSE
  REOPEN
  STATUS_CHANGE
}

model ChangeLog {
  id            Int             @id @default(autoincrement()) @map("Id")
  userId        Int?            @map("UserId")
  userName      String          @map("UserName") @db.VarChar(150)
  action        ChangeLogAction @map("Action")
  tableName     String          @map("TableName") @db.VarChar(100)
  recordId      String          @map("RecordId") @db.VarChar(64)
  recordCode    String?         @map("RecordCode") @db.VarChar(120)
  oldValues     Json?           @map("OldValues") @db.JsonB
  newValues     Json?           @map("NewValues") @db.JsonB
  changedFields String[]        @default([]) @map("ChangedFields")
  description   String          @map("Description") @db.VarChar(500)
  ipAddress     String?         @map("IpAddress") @db.VarChar(64)
  userAgent     String?         @map("UserAgent") @db.VarChar(500)
  createdAt     DateTime        @default(now()) @map("CreatedAt") @db.Timestamptz(3)

  user User? @relation("ChangeLogActor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([tableName, recordId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@index([recordCode])
  @@map("ChangeLogs")
}
