generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ============================================================================
// 1. MASTER DATA CATALOGS (25 CATALOGS — NORMALIZED RELATIONAL TABLES)
// ============================================================================

model Company {
  id               Int      @id @default(autoincrement())
  code             String   @unique @db.VarChar(50)
  name             String   @db.VarChar(150)
  registrationNo   String?  @db.VarChar(100)
  taxId            String?  @db.VarChar(100)
  country          String   @default("Maldives") @db.VarChar(100)
  baseCurrencyCode String   @default("USD") @db.VarChar(10)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createUserId     Int?
  updateUserId     Int?

  branches               Branch[]
  userAccess             UserCompanyAccess[]
  businessConfigs        BusinessConfig[]
  cashDeposits           CashDeposit[]
  cashierPayments        CashierPayment[]
  cashierSettlements     CashierSettlement[]
  cashCollectionReceipts CashCollectionReceipt[]
  mainCashierPayments    MainCashierPayment[]
  mainCashierSettlements MainCashierSettlement[]
  outletBankDeposits     OutletBankDeposit[]
  bankReconciliations    BankReconciliation[]
  pettyCashRequests      PettyCashRequest[]
  pettyCashAdvances      PettyCashAdvance[]
  pettyCashBills         PettyCashBillSubmission[]
  pettyCashReturns       PettyCashReturn[]
  floatReimbursements    FloatReimbursement[]
  salesReconciliations   SalesReconciliation[]
  varianceIncidents      VarianceIncident[]

  @@index([isActive])
  @@index([createUserId])
  @@index([updateUserId])
  @@map("companies")
}

model Branch {
  id           Int      @id @default(autoincrement())
  companyId    Int
  code         String   @unique @db.VarChar(50)
  name         String   @db.VarChar(150)
  city         String   @db.VarChar(100)
  managerName  String?  @db.VarChar(150)
  contactNo    String?  @db.VarChar(50)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createUserId Int?
  updateUserId Int?

  company                Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  outlets                Outlet[]
  locations              Location[]
  userAccess             UserBranchAccess[]
  numberSeries           NumberSeries[]
  cashDeposits           CashDeposit[]
  cashierPayments        CashierPayment[]
  cashierSettlements     CashierSettlement[]
  cashCollectionReceipts CashCollectionReceipt[]
  mainCashierPayments    MainCashierPayment[]
  mainCashierSettlements MainCashierSettlement[]
  outletBankDeposits     OutletBankDeposit[]
  bankReconciliations    BankReconciliation[]
  pettyCashRequests      PettyCashRequest[]
  pettyCashAdvances      PettyCashAdvance[]
  pettyCashBills         PettyCashBillSubmission[]
  pettyCashReturns       PettyCashReturn[]
  floatReimbursements    FloatReimbursement[]
  salesReconciliations   SalesReconciliation[]
  varianceIncidents      VarianceIncident[]

  @@index([companyId])
  @@index([isActive])
  @@index([createUserId])
  @@index([updateUserId])
  @@map("branches")
}

model Outlet {
  id            Int      @id @default(autoincrement())
  branchId      Int
  code          String   @unique @db.VarChar(50)
  name          String   @db.VarChar(150)
  outletType    String   @default("Dine-in & GrabGo") @db.VarChar(100)
  posTerminals  Int      @default(1)
  cashiersCount Int      @default(2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createUserId  Int?
  updateUserId  Int?

  branch                 Branch                    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  employees              Employee[]
  floatAccounts          FloatAccount[]
  paymentTerminals       PaymentTerminal[]
  userAccess             UserOutletAccess[]
  cashDeposits           CashDeposit[]
  cashierPayments        CashierPayment[]
  cashierSettlements     CashierSettlement[]
  cashCollectionReceipts CashCollectionReceipt[]
  mainCashierPayments    MainCashierPayment[]
  mainCashierSettlements MainCashierSettlement[]
  outletBankDeposits     OutletBankDeposit[]
  bankReconciliations    BankReconciliation[]
  pettyCashRequests      PettyCashRequest[]
  pettyCashAdvances      PettyCashAdvance[]
  pettyCashBills         PettyCashBillSubmission[]
  pettyCashReturns       PettyCashReturn[]
  floatReimbursements    FloatReimbursement[]
  salesReconciliations   SalesReconciliation[]
  varianceIncidents      VarianceIncident[]

  @@index([branchId])
  @@index([isActive])
  @@index([createUserId])
  @@index([updateUserId])
  @@map("outlets")
}

model Department {
  id               Int      @id @default(autoincrement())
  code             String   @unique @db.VarChar(50)
  name             String   @db.VarChar(150)
  headOfDepartment String?  @db.VarChar(150)
  budgetCode       String?  @db.VarChar(50)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createUserId     Int?
  updateUserId     Int?

  employees           Employee[]
  expenseCategories   ExpenseCategory[]
  budgets             Budget[]
  userAccess          UserDepartmentAccess[]
  cashierPayments     CashierPayment[]
  mainCashierPayments MainCashierPayment[]
  pettyCashRequests   PettyCashRequest[]
  pettyCashAdvances   PettyCashAdvance[]
  pettyCashBills      PettyCashBillSubmission[]
  pettyCashReturns    PettyCashReturn[]

  @@index([isActive])
  @@index([createUserId])
  @@index([updateUserId])
  @@map("departments")
}

model Location {
  id           Int      @id @default(autoincrement())
  branchId     Int
  code         String   @unique @db.VarChar(50)
  name         String   @db.VarChar(150)
  address      String?  @db.VarChar(255)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createUserId Int?
  updateUserId Int?

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([branchId])
  @@index([createUserId])
  @@index([updateUserId])
  @@map("locations")
}

model Employee {
  id           Int      @id @default(autoincrement())
  empNo        String   @unique @db.VarChar(50)
  name         String   @db.VarChar(150)
  departmentId Int
  outletId     Int?
  designation  String   @db.VarChar(100)
  email        String?  @db.VarChar(120)
  phone        String?  @db.VarChar(50)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createUserId Int?
  updateUserId Int?

  department                 Department                @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  outlet                     Outlet?                   @relation(fields: [outletId], references: [id], onDelete: SetNull)
  users                      User[]
  floatAccounts              FloatAccount[]
  cashDepositsAsCashier      CashDeposit[]             @relation("DepositCashier")
  cashDepositsAsCollector    CashDeposit[]             @relation("DepositCollector")
  cashierPaymentsAsCashier   CashierPayment[]          @relation("PaymentCashier")
  cashierPaymentsAsRequester CashierPayment[]          @relation("PaymentRequester")
  settlementsFrom            CashierSettlement[]       @relation("SettlementFromCashier")
  settlementsTo              CashierSettlement[]       @relation("SettlementToCashier")
  mainPaymentsAsRequester    MainCashierPayment[]
  mainSettlementsFrom        MainCashierSettlement[]
  pettyCashRequests          PettyCashRequest[]
  pettyCashAdvances          PettyCashAdvance[]
  pettyCashBills             PettyCashBillSubmission[]
  pettyCashIOUs              PettyCashIOU[]
  salesReconciliations       SalesReconciliation[]
  varianceIncidents          VarianceIncident[]

  @@index([departmentId])
  @@index([outletId])
  @@index([isActive])
  @@index([createUserId])
  @@index([updateUserId])
  @@map("employees")
}

model Shift {
  id            Int      @id @default(autoincrement())
  code          String   @unique @db.VarChar(50)
  name          String   @db.VarChar(100)
  startTime     String   @db.VarChar(20)
  endTime       String   @db.VarChar(20)
  durationHours Int      @default(8)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createUserId  Int?
  updateUserId  Int?

  salesReconciliations     SalesReconciliation[]
  salesReconciliationLines SalesReconciliationLine[]

  @@index([createUserId])
  @@index([updateUserId])
  @@map("shifts")
}

model Currency {
  id            Int      @id @default(autoincrement())
  code          String   @unique @db.VarChar(10)
  name          String   @db.VarChar(100)
  symbol        String   @db.VarChar(15)
  rateToBase    Decimal  @default(1) @db.Decimal(18, 6)
  localRate     Decimal? @db.Decimal(18, 6)
  decimalPlaces Int      @default(2)
  isBase        Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createUserId  Int?
  updateUserId  Int?

  fromExchangeRates         ExchangeRate[]              @relation("FromCurrency")
  toExchangeRates           ExchangeRate[]              @relation("ToCurrency")
  denominations             Denomination[]
  bankAccounts              BankAccount[]
  floatAccounts             FloatAccount[]
  paymentSubTypes           PaymentSubType[]
  cashDepositCurrencies     CashDepositCurrency[]
  cashDepositDenominations  CashDepositDenomination[]
  cashierPayments           CashierPayment[]
  cashierSettlementLines    CashierSettlementLine[]
  cashCollectionReceiptLine CashCollectionReceiptLine[]
  mainCashierPayments       MainCashierPayment[]
  mainCashierSettleLines    MainCashierSettlementLine[]
  outletBankDeposits        OutletBankDeposit[]
  bankReconciliations       BankReconciliation[]
  pettyCashRequests         PettyCashRequest[]
  pettyCashAdvances         PettyCashAdvance[]
  pettyCashBillLines        PettyCashBillLine[]
  pettyCashReturns          PettyCashReturn[]
  salesReconciliationLines  SalesReconciliationLine[]

  @@index([isBase])
  @@index([isActive])
  @@index([createUserId])
  @@index([updateUserId])
  @@map("currencies")
}

model ExchangeRate {
  id             Int      @id @default(autoincrement())
  fromCurrencyId Int
  toCurrencyId   Int
  rate           Decimal  @db.Decimal(18, 6)
  effectiveDate  DateTime @db.Date
  source         String?  @db.VarChar(150)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createUserId   Int?
  updateUserId   Int?

  fromCurrency Currency @relation("FromCurrency", fields: [fromCurrencyId], references: [id], onDelete: Restrict)
  toCurrency   Currency @relation("ToCurrency", fields: [toCurrencyId], references: [id], onDelete: Restrict)

  @@index([fromCurrencyId, toCurrencyId, effectiveDate])
  @@index([isActive])
  @@index([createUserId])
  @@index([updateUserId])
  @@map("exchange_rates")
}

model Denomination {
  id           Int     @id @default(autoincrement())
  currencyId   Int
  value        Decimal @db.Decimal(18, 2)
  label        String  @db.VarChar(100)
  denomType    String  @default("Bill") @db.VarChar(20)
  displayOrder Int     @default(1)
  isActive     Boolean @default(true)

  currency     Currency @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  createUserId Int?
  updateUserId Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@unique([currencyId, value])
  @@index([currencyId])
  @@index([createUserId])
  @@index([updateUserId])
  @@map("denominations")
}

model Bank {
  id           Int      @id @default(autoincrement())
  code         String   @unique @db.VarChar(50)
  name         String   @db.VarChar(150)
  swiftCode    String?  @db.VarChar(50)
  country      String   @default("Maldives") @db.VarChar(100)
  contactInfo  String?  @db.VarChar(150)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createUserId Int?
  updateUserId Int?

  bankAccounts     BankAccount[]
  paymentTerminals PaymentTerminal[]

  @@index([createUserId])
  @@index([updateUserId])
  @@map("banks")
}

model BankAccount {
  id             Int      @id @default(autoincrement())
  bankId         Int
  currencyId     Int
  accountNo      String   @unique @db.VarChar(100)
  name           String   @db.VarChar(150)
  branchLocation String?  @db.VarChar(150)
  accountType    String   @default("Current") @db.VarChar(50)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createUserId   Int?
  updateUserId   Int?

  bank                   Bank                    @relation(fields: [bankId], references: [id], onDelete: Restrict)
  currency               Currency                @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  cashCollectionReceipts CashCollectionReceipt[]
  mainCashierSettlements MainCashierSettlement[]
  outletBankDeposits     OutletBankDeposit[]

  @@index([bankId])
  @@index([currencyId])
  @@index([createUserId])
  @@index([updateUserId])
  @@map("bank_accounts")
}

model FloatAccount {
  id                 Int      @id @default(autoincrement())
  code               String   @unique @db.VarChar(50)
  name               String   @db.VarChar(150)
  currencyId         Int
  assignedEmployeeId Int?
  outletId           Int?
  baseLimit          Decimal  @default(0) @db.Decimal(18, 2)
  currentBalance     Decimal  @default(0) @db.Decimal(18, 2)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  createUserId       Int?
  updateUserId       Int?

  currency            Currency             @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  assignedEmployee    Employee?            @relation(fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  outlet              Outlet?              @relation(fields: [outletId], references: [id], onDelete: SetNull)
  cashierPayments     CashierPayment[]
  cashierSettlements  CashierSettlement[]
  mainCashierPayments MainCashierPayment[]
  pettyCashAdvances   PettyCashAdvance[]
  floatReimbursements FloatReimbursement[]

  @@index([currencyId])
  @@index([assignedEmployeeId])
  @@index([outletId])
  @@index([createUserId])
  @@index([updateUserId])
  @@map("float_accounts")
}

model GlAccount {
  id           Int      @id @default(autoincrement())
  code         String   @unique @db.VarChar(50)
  name         String   @db.VarChar(150)
  category     String   @db.VarChar(50)
  isCashBank   Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createUserId Int?
  updateUserId Int?

  expenseCategories ExpenseCategory[]
  paymentTypes      PaymentType[]

  @@index([createUserId])
  @@index([updateUserId])
  @@map("gl_accounts")
}

model Vendor {
  id           Int      @id @default(autoincrement())
  code         String   @unique @db.VarChar(50)
  name         String   @db.VarChar(150)
  category     String   @db.VarChar(100)
  taxId        String?  @db.VarChar(100)
  contactInfo  String?  @db.VarChar(150)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createUserId Int?
  updateUserId Int?

  cashierPayments     CashierPayment[]
  mainCashierPayments MainCashierPayment[]
  pettyCashBillLines  PettyCashBillLine[]

  @@index([createUserId])
  @@index([updateUserId])
  @@map("vendors")
}

model ExpenseCategory {
  id           Int      @id @default(autoincrement())
  code         String   @unique @db.VarChar(50)
  name         String   @db.VarChar(150)
  departmentId Int
  glAccountId  Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createUserId Int?
  updateUserId Int?

  department         Department          @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  glAccount          GlAccount           @relation(fields: [glAccountId], references: [id], onDelete: Restrict)
  expenseTypes       ExpenseType[]
  pettyCashRequests  PettyCashRequest[]
  pettyCashAdvances  PettyCashAdvance[]
  pettyCashBillLines PettyCashBillLine[]

  @@index([departmentId])
  @@index([glAccountId])
  @@index([createUserId])
  @@index([updateUserId])
  @@map("expense_categories")
}

model ExpenseType {
  id                Int      @id @default(autoincrement())
  categoryId        Int
  code              String   @unique @db.VarChar(50)
  name              String   @db.VarChar(150)
  taxApplicable     Boolean  @default(true)
  requiresQuoteOver Decimal  @default(100) @db.Decimal(18, 2)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createUserId      Int?
  updateUserId      Int?

  category ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([categoryId])
  @@index([createUserId])
  @@index([updateUserId])
  @@map("expense_types")
}

model Budget {
  id              Int      @id @default(autoincrement())
  departmentId    Int
  fiscalYear      String   @db.VarChar(10)
  allocatedAmount Decimal  @default(0) @db.Decimal(18, 2)
  monthlyLimit    Decimal  @default(0) @db.Decimal(18, 2)
  consumedAmount  Decimal  @default(0) @db.Decimal(18, 2)
  availableAmount Decimal  @default(0) @db.Decimal(18, 2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createUserId    Int?
  updateUserId    Int?

  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@unique([departmentId, fiscalYear])
  @@index([departmentId])
  @@index([createUserId])
  @@index([updateUserId])
  @@map("budgets")
}

model CashAdvanceType {
  id              Int      @id @default(autoincrement())
  code            String   @unique @db.VarChar(50)
  name            String   @db.VarChar(100)
  description     String?  @db.VarChar(255)
  defaultMaxLimit Decimal  @default(500) @db.Decimal(18, 2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createUserId    Int?
  updateUserId    Int?

  @@index([createUserId])
  @@index([updateUserId])
  @@map("cash_advance_types")
}

model PaymentType {
  id                    Int      @id @default(autoincrement())
  code                  String   @unique @db.VarChar(50)
  name                  String   @db.VarChar(100)
  autoFillFromProcess01 Boolean  @default(false)
  glAccountId           Int
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  createUserId          Int?
  updateUserId          Int?

  glAccount                GlAccount                 @relation(fields: [glAccountId], references: [id], onDelete: Restrict)
  subTypes                 PaymentSubType[]
  cashDeposits             CashDeposit[]
  salesReconciliationLines SalesReconciliationLine[]

  @@index([glAccountId])
  @@index([createUserId])
  @@index([updateUserId])
  @@map("payment_types")
}

model PaymentSubType {
  id               Int      @id @default(autoincrement())
  paymentTypeId    Int
  currencyId       Int
  code             String   @unique @db.VarChar(50)
  name             String   @db.VarChar(150)
  surchargePct     Decimal  @default(0) @db.Decimal(5, 2)
  terminalRequired Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createUserId     Int?
  updateUserId     Int?

  paymentType PaymentType @relation(fields: [paymentTypeId], references: [id], onDelete: Restrict)
  currency    Currency    @relation(fields: [currencyId], references: [id], onDelete: Restrict)

  @@index([paymentTypeId])
  @@index([currencyId])
  @@index([createUserId])
  @@index([updateUserId])
  @@map("payment_sub_types")
}

model PaymentTerminal {
  id           Int      @id @default(autoincrement())
  code         String   @unique @db.VarChar(50)
  terminalName String   @db.VarChar(150)
  serialNo     String   @unique @db.VarChar(100)
  outletId     Int
  bankId       Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createUserId Int?
  updateUserId Int?

  outlet Outlet @relation(fields: [outletId], references: [id], onDelete: Restrict)
  bank   Bank   @relation(fields: [bankId], references: [id], onDelete: Restrict)

  @@index([outletId])
  @@index([bankId])
  @@index([createUserId])
  @@index([updateUserId])
  @@map("payment_terminals")
}

model ApprovalWorkflowMaster {
  id             Int      @id @default(autoincrement())
  code           String   @unique @db.VarChar(50)
  name           String   @db.VarChar(150)
  stagesCount    Int      @default(3)
  appliesTo      String   @db.VarChar(150)
  thresholdLabel String   @db.VarChar(80)
  thresholdValue Decimal  @default(0) @db.Decimal(18, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createUserId   Int?
  updateUserId   Int?

  @@index([createUserId])
  @@index([updateUserId])
  @@map("approval_workflows")
}

model FormMaster {
  id               Int      @id @default(autoincrement())
  formId           String   @unique @db.VarChar(60)
  formName         String   @db.VarChar(150)
  category         String   @db.VarChar(80)
  module           String   @db.VarChar(80)
  screenId         String?  @db.VarChar(60)
  routeKey         String?  @db.VarChar(100)
  defaultPrefix    String   @db.VarChar(30)
  defaultNumDigits Int      @default(4)
  isTransactional  Boolean  @default(true)
  makerCheckerType String   @default("Standard") @db.VarChar(60)
  description      String?  @db.VarChar(255)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createUserId     Int?
  updateUserId     Int?

  numberSeries NumberSeries[]
  screens      Screen[]

  @@index([category])
  @@index([createUserId])
  @@index([updateUserId])
  @@map("form_masters")
}

// ============================================================================
// 2. AUTHENTICATION, USERS, ROLES, GROUPS, SCREEN AUTHORIZATION & CONFIG
// ============================================================================

model Role {
  id           Int      @id @default(autoincrement())
  code         String   @unique @db.VarChar(50)
  name         String   @db.VarChar(100)
  description  String?  @db.VarChar(255)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createUserId Int?
  updateUserId Int?

  permissions RolePermission[]
  users       User[]
  userGroups  UserGroup[]

  @@index([createUserId])
  @@index([updateUserId])
  @@map("roles")
}

model RolePermission {
  id         Int     @id @default(autoincrement())
  roleId     Int
  moduleKey  String  @db.VarChar(60)
  canRead    Boolean @default(false)
  canCreate  Boolean @default(false)
  canUpdate  Boolean @default(false)
  canDelete  Boolean @default(false)
  canApprove Boolean @default(false)
  canUnblock Boolean @default(false)

  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createUserId Int?
  updateUserId Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@unique([roleId, moduleKey])
  @@index([roleId])
  @@index([createUserId])
  @@index([updateUserId])
  @@map("role_permissions")
}

model UserGroup {
  id            Int      @id @default(autoincrement())
  groupCode     String   @unique @db.VarChar(50)
  userGroupId   String   @unique @db.VarChar(50)
  name          String   @db.VarChar(150)
  description   String?  @db.VarChar(255)
  defaultRoleId Int
  defaultBadge  String   @default("User") @db.VarChar(40)
  isAllFullAuth Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
